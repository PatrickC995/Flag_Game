<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:fillViewport="true"
    tools:context=".GuessTheCountryPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/round_score_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Score: 0"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Guess the Country"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Look at the flag, choose its country and press Submit."
            android:textColor="@color/game_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="WHICH COUNTRY IS THIS?"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <ImageView
                android:id="@+id/guess_the_country_image_view"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:contentDescription="Country flag"
                android:scaleType="fitCenter" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/guess_the_country_spinner"
                android:text="Your answer"
                android:textColor="@color/game_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap the list to choose a country."
                android:textColor="@color/game_text_secondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/guess_the_country_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:spinnerMode="dropdown"
                android:backgroundTint="@color/game_primary" />

        </LinearLayout>


        <TextView
            android:id="@+id/result_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/game_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/answer_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/game_answer_blue"
            android:textSize="18sp"
            android:lineSpacingExtra="3dp"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/submit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@color/game_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/game_primary"
            app:backgroundTint="@color/game_primary" />

        <Button
            android:id="@+id/exit_guess_the_country_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Back to menu"
            android:textAllCaps="false"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:backgroundTint="@color/game_surface"
            app:backgroundTint="@color/game_surface" />

    </LinearLayout>

</ScrollView>

    <!-- The Use of AI was used to help implement my projects Design decision, Design decisions are my own, AI was only used to help with implementation -->