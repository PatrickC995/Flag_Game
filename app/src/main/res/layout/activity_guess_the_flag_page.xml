<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/round_score_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Score: 0"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/guess_flag_title"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/guess_flag_instructions"
            android:textColor="@color/game_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp" />

        <!-- Country prompt -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="FIND THE FLAG FOR"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/guess_flag_country_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/game_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite" />

        </LinearLayout>

        <!-- Flag option 1 -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/game_card_background"
            android:padding="12dp">

            <ImageView
                android:id="@+id/guess_flag_image_1"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="@string/guess_flag_option_1" />

        </FrameLayout>

        <!-- Flag option 2 -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/game_card_background"
            android:padding="12dp">

            <ImageView
                android:id="@+id/guess_flag_image_2"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="@string/guess_flag_option_2" />

        </FrameLayout>

        <!-- Flag option 3 -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/game_card_background"
            android:padding="12dp">

            <ImageView
                android:id="@+id/guess_flag_image_3"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:contentDescription="@string/guess_flag_option_3" />

        </FrameLayout>

        <!-- Answer feedback -->

        <TextView
            android:id="@+id/guess_flag_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/guess_flag_next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/guess_flag_next"
            android:textAllCaps="false"
            android:textColor="@color/game_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/game_primary"
            app:backgroundTint="@color/game_primary"
            android:visibility="gone" />

        <Button
            android:id="@+id/guess_flag_exit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/guess_flag_exit"
            android:textAllCaps="false"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:backgroundTint="@color/game_surface"
            app:backgroundTint="@color/game_surface" />

    </LinearLayout>

</ScrollView>