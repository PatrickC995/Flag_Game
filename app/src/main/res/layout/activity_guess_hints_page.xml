<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/round_score_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Score: 0"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Guess Hints"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Reveal the country name one letter at a time. You can make up to three incorrect guesses."
            android:textColor="@color/game_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="REVEAL THE COUNTRY"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <ImageView
                android:id="@+id/guess_hint_flag_image_view"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Flag of the country to guess" />

            <TextView
                android:id="@+id/guess_hint_hidden_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/game_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Incorrect guesses"
                android:textColor="@color/game_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mistake_dot_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/mistake_dot"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/mistake_dot_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/mistake_dot"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/mistake_dot_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/mistake_dot"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <TextView
                android:id="@+id/guess_hint_attempts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/game_text_secondary"
                android:textSize="16sp"
                android:accessibilityLiveRegion="polite" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/guess_hint_letter_input"
                android:text="Your next letter"
                android:textColor="@color/game_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/guess_hint_letter_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:hint="Enter one letter"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:singleLine="true"
                android:gravity="center"
                android:textColor="@color/game_text"
                android:textColorHint="@color/game_text_secondary"
                android:textSize="22sp"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

        </LinearLayout>


        <TextView
            android:id="@+id/guess_hint_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/game_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/guess_hint_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/game_answer_blue"
            android:textSize="20sp"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/guess_hint_submit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@color/game_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/game_primary"
            app:backgroundTint="@color/game_primary" />

        <Button
            android:id="@+id/guess_hints_exit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Back to menu"
            android:textAllCaps="false"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:backgroundTint="@color/game_surface"
            app:backgroundTint="@color/game_surface" />

    </LinearLayout>

</ScrollView>

    <!-- The Use of AI was used to help implement my projects Design decision -->