<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guess Hints"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guess the country by entering one letter at a time. You can make up to three incorrect guesses."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/guess_hint_flag_image_view"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="fitCenter"
            android:contentDescription="Flag of the country to guess" />

        <TextView
            android:id="@+id/guess_hint_hidden_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/mistake_dot_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/mistake_dot"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/mistake_dot_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/mistake_dot"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/mistake_dot_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/mistake_dot"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <TextView
            android:id="@+id/guess_hint_attempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="18sp"
            android:accessibilityLiveRegion="polite" />

        <EditText
            android:id="@+id/guess_hint_letter_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:hint="Enter one letter"
            android:inputType="text"
            android:maxLines="1"
            android:gravity="center"
            android:textSize="20sp" />

        <Button
            android:id="@+id/guess_hint_submit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minWidth="140dp"
            android:text="Submit" />

        <TextView
            android:id="@+id/guess_hint_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/guess_hint_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="22sp" />

    </LinearLayout>

</ScrollView>