<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/main_menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Country Games"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Choose how you want to play."
            android:textColor="@color/game_text_secondary"
            android:textSize="16sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recognise the flag"
                android:textColor="@color/game_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Look at a flag and select the country it belongs to."
                android:textColor="@color/game_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/guess_the_country_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Guess the Country"
                android:textAllCaps="false"
                android:textColor="@color/game_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="One letter at a time"
                android:textColor="@color/game_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reveal the hidden country name by guessing its letters."
                android:textColor="@color/game_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/guess_hints_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Guess Hints"
                android:textAllCaps="false"
                android:textColor="@color/game_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick the matching flag"
                android:textColor="@color/game_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Read the country name, then tap its flag. You get one choice per round."
                android:textColor="@color/game_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/guess_the_flag_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Guess the Flag"
                android:textAllCaps="false"
                android:textColor="@color/game_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take on three flags"
                android:textColor="@color/game_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Type all three country names before you use up three unsuccessful submissions."
                android:textColor="@color/game_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/advanced_level_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Advanced Level"
                android:textAllCaps="false"
                android:textColor="@color/game_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

        </LinearLayout>

        <Button
            android:id="@+id/exit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="Exit"
            android:textAllCaps="false"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:backgroundTint="@color/game_surface"
            app:backgroundTint="@color/game_surface" />

    </LinearLayout>

</ScrollView>

    <!-- The Use of AI was used to help implement my projects Design decision -->