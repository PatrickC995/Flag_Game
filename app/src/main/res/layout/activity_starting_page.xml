<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".StartingPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/game_card_background"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="EXPLORE THE WORLD"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/flag_game_title_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Country Flag Game"
                android:textColor="@color/game_text"
                android:textSize="32sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="How well do you know your flags? Choose a game mode and put your knowledge to the test."
                android:textColor="@color/game_text_secondary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/new_flag_game_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="New Game"
                android:textAllCaps="false"
                android:textColor="@color/game_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

            <Button
                android:id="@+id/about_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="About"
                android:textAllCaps="false"
                android:textColor="@color/game_text"
                android:textSize="16sp"
                android:backgroundTint="@color/game_background"
                app:backgroundTint="@color/game_background" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/about_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/game_card_background"
                android:padding="20dp"
                android:textColor="@color/game_text"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"
                android:visibility="gone"
                tools:text="Your existing declaration will appear here when About is selected."
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

    <!-- The Use of AI was used to help implement my projects Design decision -->