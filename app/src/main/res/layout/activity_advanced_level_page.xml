<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Advanced Level"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Enter the country name for each flag. You have three unsuccessful submissions."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/advanced_attempts_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Unsuccessful submissions: 0 / 3"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- First flag and answer -->

        <ImageView
            android:id="@+id/advanced_flag_1"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Flag 1"
            android:scaleType="fitCenter" />

        <EditText
            android:id="@+id/advanced_answer_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Country for flag 1"
            android:inputType="textCapWords|textNoSuggestions"
            android:maxLength="100"
            android:minHeight="48dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/advanced_correct_answer_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#0000FF"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Second flag and answer -->

        <ImageView
            android:id="@+id/advanced_flag_2"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Flag 2"
            android:scaleType="fitCenter" />

        <EditText
            android:id="@+id/advanced_answer_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Country for flag 2"
            android:inputType="textCapWords|textNoSuggestions"
            android:maxLength="100"
            android:minHeight="48dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/advanced_correct_answer_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#0000FF"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Third flag and answer -->

        <ImageView
            android:id="@+id/advanced_flag_3"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Flag 3"
            android:scaleType="fitCenter" />

        <EditText
            android:id="@+id/advanced_answer_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Country for flag 3"
            android:inputType="textCapWords|textNoSuggestions"
            android:maxLength="100"
            android:minHeight="48dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/advanced_correct_answer_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#0000FF"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/advanced_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/advanced_submit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Submit" />

        <Button
            android:id="@+id/advanced_exit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back to menu" />

    </LinearLayout>

</ScrollView>