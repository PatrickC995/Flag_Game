<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Advanced Level"
            android:textColor="@color/game_text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Name all three flags. Correct answers stay locked while you work on the others."
            android:textColor="@color/game_text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="The round ends after three unsuccessful submissions."
            android:textColor="@color/game_text_secondary"
            android:textSize="14sp" />

        <!-- Attempts counter -->

        <TextView
            android:id="@+id/advanced_attempts_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/game_card_background"
            android:padding="16dp"
            android:gravity="center"
            android:text="Unsuccessful submissions: 0 / 3"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite" />

        <!-- Flag 1 and its answer -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FLAG 1"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:accessibilityHeading="true" />

            <ImageView
                android:id="@+id/advanced_flag_1"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:contentDescription="Flag 1"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/advanced_answer_1"
                android:text="Country name"
                android:textColor="@color/game_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/advanced_answer_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Country for flag 1"
                android:inputType="textCapWords|textNoSuggestions"
                android:maxLength="100"
                android:minHeight="56dp"
                android:singleLine="true"
                android:textColor="@color/game_text"
                android:textColorHint="@color/game_text_secondary"
                android:textSize="18sp"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

            <TextView
                android:id="@+id/advanced_correct_answer_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/game_answer_blue"
                android:textSize="16sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Flag 2 and its answer -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FLAG 2"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:accessibilityHeading="true" />

            <ImageView
                android:id="@+id/advanced_flag_2"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:contentDescription="Flag 2"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/advanced_answer_2"
                android:text="Country name"
                android:textColor="@color/game_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/advanced_answer_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Country for flag 2"
                android:inputType="textCapWords|textNoSuggestions"
                android:maxLength="100"
                android:minHeight="56dp"
                android:singleLine="true"
                android:textColor="@color/game_text"
                android:textColorHint="@color/game_text_secondary"
                android:textSize="18sp"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

            <TextView
                android:id="@+id/advanced_correct_answer_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/game_answer_blue"
                android:textSize="16sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Flag 3 and its answer -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/game_card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FLAG 3"
                android:textColor="@color/game_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:accessibilityHeading="true" />

            <ImageView
                android:id="@+id/advanced_flag_3"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:contentDescription="Flag 3"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/advanced_answer_3"
                android:text="Country name"
                android:textColor="@color/game_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/advanced_answer_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Country for flag 3"
                android:inputType="textCapWords|textNoSuggestions"
                android:maxLength="100"
                android:minHeight="56dp"
                android:singleLine="true"
                android:textColor="@color/game_text"
                android:textColorHint="@color/game_text_secondary"
                android:textSize="18sp"
                android:backgroundTint="@color/game_primary"
                app:backgroundTint="@color/game_primary" />

            <TextView
                android:id="@+id/advanced_correct_answer_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/game_answer_blue"
                android:textSize="16sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Round result -->

        <TextView
            android:id="@+id/advanced_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <Button
            android:id="@+id/advanced_submit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@color/game_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/game_primary"
            app:backgroundTint="@color/game_primary" />

        <Button
            android:id="@+id/advanced_exit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Back to menu"
            android:textAllCaps="false"
            android:textColor="@color/game_text"
            android:textSize="16sp"
            android:backgroundTint="@color/game_surface"
            app:backgroundTint="@color/game_surface" />

    </LinearLayout>

</ScrollView>